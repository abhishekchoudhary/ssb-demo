  "footer": {
    "mode": "grid",
    "blocks": [
      {
        "id": "sample-footer-logo",
        "x": 0,
        "y": 0,
        "w": 1,
        "h": 1,
        "align": "left",
        "enabled": true,
        "type": "image",
        "source": "/uploads/sample-logo.png",
        "alt": "A small page mark",
        "href": "/"
      },
      {
        "id": "sample-footer-title",
        "x": 1,
        "y": 0,
        "w": 5,
        "h": 1,
        "align": "left",
        "enabled": true,
        "type": "text",
        "text": "{title}\nA little room for the things you notice.",
        "size": "normal"
      },
      {
        "id": "sample-footer-note",
        "x": 7,
        "y": 0,
        "w": 5,
        "h": 1,
        "align": "left",
        "enabled": true,
        "type": "html",
        "source": "<p><strong>Leave a little room.</strong><br>For a thought, a picture, or the next good sentence.</p>"
      },
      {
        "id": "sample-footer-rss",
        "x": 0,
        "y": 1,
        "w": 3,
        "h": 1,
        "align": "left",
        "enabled": true,
