        "id": "sample-footer-guide",
        "x": 5,
        "y": 1,
        "w": 3,
        "h": 1,
        "align": "left",
        "enabled": true,
        "type": "icon",
        "icon": "book",
        "label": "Field guide",
        "href": "/field-guide/",
